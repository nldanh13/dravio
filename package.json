{
  "name": "dravio",
  "private": true,
  "version": "0.1.0",
  "description": "Dravio — Cozy Dragon Ecosystem & Sanctuary Simulation",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "art:shade": "node scripts/art/generate-ancient-shading.mjs",
    "predev": "npm run art:shade",
    "prebuild": "npm run art:shade",
    "pretest": "node --test scripts/art/ancient-shading.test.mjs && npm run art:shade",
    "pretest:watch": "npm run art:shade"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
